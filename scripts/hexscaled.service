[Unit]
Description=Hexscale Qualcomm Hexagon NPU Super-Resolution Service
After=network.target systemd-modules-load.service
Wants=gamescope.service

[Service]
Type=simple
ExecStart=/usr/bin/hexscaled --socket /run/hexscale/control.sock --model /usr/share/hexscale/models/xlsr_htp_v73.bin
Restart=always
RestartSec=2s
RuntimeDirectory=hexscale
RuntimeDirectoryMode=0775
DeviceAllow=/dev/fastrpc-cdsp rw
DeviceAllow=/dev/fastrpc-cdsp-secure rw
ProtectHome=read-only
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
