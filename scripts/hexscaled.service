[Unit]
Description=Hexscale sharpening control daemon (hexscaled)
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/hexscaled --socket /run/hexscale/control.sock
Restart=on-failure
RestartSec=2s
RuntimeDirectory=hexscale
RuntimeDirectoryMode=0777
# Optional NPU access (dma-buf mapping); the daemon degrades gracefully
# without it — GPU sharpening does not need these devices.
DeviceAllow=/dev/fastrpc-cdsp rw

[Install]
WantedBy=multi-user.target
